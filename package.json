{
  "name": "empires-of-meridian",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:browser": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.1",
    "@types/three": "0.186.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "three": "0.186.0",
    "turbo": "2.5.6",
    "typescript-eslint": "8.70.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
