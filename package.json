{
  "name": "empires-of-meridian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1 --port 5173",
    "dev:web": "vite apps/web --host 127.0.0.1 --port 5173",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:game-server": "tsx watch apps/game-server/src/index.ts",
    "stack": "tsx scripts/dev-stack.ts",
    "build": "tsc --noEmit && vite build apps/web",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:determinism": "vitest run tests/sim",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "content:reference": "tsx scripts/generate-content-reference.ts",
    "audio:tts": "node scripts/generate-gemini-tts.mjs",
    "ai:evaluate": "tsx packages/test-harness/src/evaluate-ai.ts",
    "ai:train": "tsx scripts/train-ai-policy.ts",
    "ai:evaluate:local": "tsx scripts/evaluate-ai.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.17.35",
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "5.8.2",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.63.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "turbo": "2.5.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.42.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.19.0"
}
